<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="false" />
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="welcome.php" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <rule name="Admin Root" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="index.php" />
                </rule>
                <rule name="Admin Welcome" stopProcessing="true">
                    <match url="^welcome$" />
                    <action type="Rewrite" url="welcome.php" />
                </rule>
            </rules>
        </rewrite>
        <security>
            <requestFiltering>
                <denyUrlSequences>
                    <add sequence=".." />
                </denyUrlSequences>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
